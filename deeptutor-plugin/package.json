{
  "name": "@local/deeptutor",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Pure-JS study mode for DeepSeek Harness: teach, quiz with local grading, wrong-answer notebook with spaced repetition, and knowledge-base management. Zero Python dependency.",
  "scripts": {},
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "src", "cordis.patch.yml", "locale/*.json", "docs", "icon.svg"],
  "dsh": {
    "composite": true,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-chat"]
    }
  }
}
